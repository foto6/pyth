<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/widget_title_area" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingLeft="2dp" android:paddingRight="6dp">
            <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Daily Focus" android:textColor="@color/widget_text" android:textSize="15sp" />
            <TextView android:id="@+id/widget_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Спокойный прогресс на сегодня" android:textColor="@color/widget_muted" android:textSize="9sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_goal_pill" android:layout_width="82dp" android:layout_height="48dp" android:background="@drawable/widget_goal_pill" android:fontFamily="sans-serif-medium" android:gravity="center" android:maxLines="1" android:text="Цель 2ч" android:textColor="@color/widget_wood" android:textSize="11sp" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginLeft="4dp" android:background="@drawable/widget_icon_button" android:gravity="center" android:text="↻" android:textColor="@color/widget_sky" android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="2dp" android:gravity="bottom" android:orientation="horizontal">
        <TextView android:id="@+id/widget_usage" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:maxLines="1" android:text="0м" android:textColor="@color/widget_text" android:textSize="28sp" />
        <TextView android:id="@+id/widget_usage_caption" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="сегодня" android:textColor="@color/widget_muted" android:textSize="10sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:max="1000" android:progress="0" android:progressDrawable="@drawable/widget_progress" />
    <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_marginTop="5dp" android:background="@drawable/widget_status_pill" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:maxLines="1" android:paddingLeft="10dp" android:paddingRight="10dp" android:text="До цели 2ч" android:textColor="@color/widget_leaf_dark" android:textSize="11sp" />
    <LinearLayout android:id="@+id/widget_apps" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_app_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp">
            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/widget_badge_firefox" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="F" android:textColor="@color/widget_wood" android:textSize="12sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="7dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Firefox" android:textColor="@color/widget_text" android:textSize="11sp" />
                <TextView android:id="@+id/widget_firefox_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0м" android:textColor="@color/widget_muted" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="7dp" android:layout_weight="1" android:background="@drawable/widget_app_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp">
            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/widget_badge_chatgpt" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="AI" android:textColor="@color/widget_leaf_dark" android:textSize="9sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="7dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="ChatGPT" android:textColor="@color/widget_text" android:textSize="11sp" />
                <TextView android:id="@+id/widget_chatgpt_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0м" android:textColor="@color/widget_muted" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_tasks_header" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="Задачи" android:textColor="@color/widget_text" android:textSize="11sp" />
        <TextView android:id="@+id/widget_tasks_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="0 / 0" android:textColor="@color/widget_muted" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_empty_tasks" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="3dp" android:gravity="center_vertical" android:text="＋ Добавить задачу" android:textColor="@color/widget_sky" android:textSize="12sp" android:background="@drawable/widget_task_row" android:paddingLeft="12dp" />
    <LinearLayout android:id="@+id/widget_task_row_1" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/widget_task_row" android:paddingLeft="4dp" android:paddingRight="8dp">
        <TextView android:id="@+id/widget_task_mark_1" android:layout_width="44dp" android:layout_height="match_parent" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="○" android:textColor="@color/widget_faint" android:textSize="25sp" />
        <TextView android:id="@+id/widget_task_title_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/widget_text" android:textSize="12sp" android:gravity="center_vertical" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_task_row_2" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/widget_task_row" android:paddingLeft="4dp" android:paddingRight="8dp">
        <TextView android:id="@+id/widget_task_mark_2" android:layout_width="44dp" android:layout_height="match_parent" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="○" android:textColor="@color/widget_faint" android:textSize="25sp" />
        <TextView android:id="@+id/widget_task_title_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/widget_text" android:textSize="12sp" android:gravity="center_vertical" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_task_row_3" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/widget_task_row" android:paddingLeft="4dp" android:paddingRight="8dp">
        <TextView android:id="@+id/widget_task_mark_3" android:layout_width="44dp" android:layout_height="match_parent" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="○" android:textColor="@color/widget_faint" android:textSize="25sp" />
        <TextView android:id="@+id/widget_task_title_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/widget_text" android:textSize="12sp" android:gravity="center_vertical" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_task_row_4" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/widget_task_row" android:paddingLeft="4dp" android:paddingRight="8dp">
        <TextView android:id="@+id/widget_task_mark_4" android:layout_width="44dp" android:layout_height="match_parent" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="○" android:textColor="@color/widget_faint" android:textSize="25sp" />
        <TextView android:id="@+id/widget_task_title_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/widget_text" android:textSize="12sp" android:gravity="center_vertical" />
    </LinearLayout>
</LinearLayout>