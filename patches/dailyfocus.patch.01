diff -ruN '--exclude=.gradle' '--exclude=build' df_old/DailyFocus/app/src/main/java/com/foto6/dailyfocus/core/WidgetLayoutPolicy.kt DailyFocus/app/src/main/java/com/foto6/dailyfocus/core/WidgetLayoutPolicy.kt
--- df_old/DailyFocus/app/src/main/java/com/foto6/dailyfocus/core/WidgetLayoutPolicy.kt	1970-01-01 00:00:00.000000000 +0000
+++ DailyFocus/app/src/main/java/com/foto6/dailyfocus/core/WidgetLayoutPolicy.kt	2026-09-25 07:31:35.855399016 +0000
@@ -0,0 +1,16 @@
+package com.foto6.dailyfocus.core
+
+data class WidgetLayout(
+    val showStatus: Boolean,
+    val showApps: Boolean,
+    val maxTasks: Int
+)
+
+object WidgetLayoutPolicy {
+    fun forHeight(heightDp: Int): WidgetLayout = when {
+        heightDp < 230 -> WidgetLayout(showStatus = false, showApps = false, maxTasks = 1)
+        heightDp < 285 -> WidgetLayout(showStatus = true, showApps = false, maxTasks = 2)
+        heightDp < 320 -> WidgetLayout(showStatus = true, showApps = true, maxTasks = 3)
+        else -> WidgetLayout(showStatus = true, showApps = true, maxTasks = 4)
+    }
+}
